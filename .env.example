# ==============================================================================
# DoVe — Mẫu Biến Môi Trường (Environment Variables Template)
# Sao chép file này thành .env để cấu hình môi trường local.
# TUYỆT ĐỐI KHÔNG commit file .env chứa secret thật vào git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cơ sở dữ liệu PostgreSQL (Local / Docker)
# ------------------------------------------------------------------------------
POSTGRES_DB=dove
POSTGRES_USER=dove
POSTGRES_PASSWORD=dove
POSTGRES_PORT=5432

# URL kết nối JDBC cho Spring Boot API
DB_URL=jdbc:postgresql://localhost:5432/dove
DB_USER=dove
DB_PASSWORD=dove

# ------------------------------------------------------------------------------
# 2. Cấu hình Spring Boot Backend API
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# API Key cho các endpoint quản trị / trigger scraper nội bộ (bắt buộc >= 32 ký tự ở production, ví dụ sinh bằng: openssl rand -hex 24)
DOVE_ADMIN_API_KEY=dove-local-admin-secret-key-change-in-production

# Giới hạn số lượt request / phút cho tính năng dò vé (mặc định: 60)
DOVE_RATE_LIMIT_CHECK_PER_MINUTE=60

# CORS allowed origins (phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ------------------------------------------------------------------------------
# 3. Cấu hình Mobile App (Expo / React Native)
# Biến có tiền tố EXPO_PUBLIC_ sẽ được nhúng vào client bundle
# ------------------------------------------------------------------------------
# Đối với máy ảo Android: http://10.0.2.2:8080
# Đối với máy thật / Expo Go: http://<IP_LAN_CUA_BAN>:8080 (ví dụ: http://192.168.1.50:8080)
# Đối với iOS Simulator: http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

